---
import Block from "./Block.astro";

const { blok, language, slug } = Astro.props;
---

<main class={`w-[92%] md:w-3/4 mx-auto ${slug === "" ? "mb-16" : "my-16"} flex flex-col gap-8`} >
	{
		blok.body?.map((nestedBlok: any) => {
			return <Block block={nestedBlok} language={language} />;
		})
	}
</main>
