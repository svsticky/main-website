---
import { Image } from "astro:assets";
const blok = Astro.props;

const link = blok.link?.cached_url || blok.link?.url || blok.link;
---

{!!blok.images?.length &&
  <section class="w-full" >
    <a
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="relative block w-full max-h-32 md:max-h-40 rounded-2xl overflow-hidden border border-neutral-200"
    >
      {blok.images.map((image: any, idx: number) => (
        <img
          src={`${image.url}`}
          alt={blok.partner_name || ''}
          class="featured-banner-item inset-0 w-full h-full transition-opacity duration-1000 object-cover"
          style={`opacity: ${idx === 0 ? 1 : 0};`}
        />
      ))}
    </a>
  </section>
}

<script>
  const items = Array.from(document.querySelectorAll<HTMLImageElement>('.featured-banner-item'));
  let current = 0;

  if (items.length > 1) {
    setInterval(() => {
      items[current].style.opacity = '0';
      current = (current + 1) % items.length;
      items[current].style.opacity = '1';
    }, 5000);
  }
</script>
