---
import {convertLexicalToPlaintext} from "@payloadcms/richtext-lexical/plaintext";
import { Image } from "astro:assets";
import payload from "../../payload";
const { blok, language } = Astro.props;

const { docs: news_items } = await payload.find({
  collection: "news-items",
  draft: false,
  locale: language,
  limit: 5,
  sort: "-date"
});

const date_formatter = new Intl.DateTimeFormat(language === undefined ? 'nl-NL' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
function format_date(date: string) {
  if (!date) return '';
  return date_formatter.format(new Date(date.replace(' ', 'T')));
}

function get_excerpt(richtext: any, max_length = 90) {
  const text = convertLexicalToPlaintext({ data: richtext });
  if (text.length <= max_length) return text;
  return text.slice(0, max_length).replace(/\s+\S*$/, '') + '...';
}
---

<section class="" >
  {!!news_items.length ? (
    <div class="relative">
      <button id="news-carousel-left" aria-label="Vorige" class="hidden md:flex absolute -left-5 top-1/2 -translate-y-1/2 z-10 items-center justify-center w-10 h-10 rounded-full bg-white border border-neutral-200 shadow hover:bg-neutral-50 transition">
        <i class="fas fa-chevron-left"></i>
      </button>
      <button id="news-carousel-right" aria-label="Volgende" class="hidden md:flex absolute -right-5 top-1/2 -translate-y-1/2 z-10 items-center justify-center w-10 h-10 rounded-full bg-white border border-neutral-200 shadow hover:bg-neutral-50 transition">
        <i class="fas fa-chevron-right"></i>
      </button>

      <ul id="news-carousel-track" class="flex gap-6 overflow-x-auto scroll-smooth pt-2 pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {news_items.map((item: any) => (
          <li class="shrink-0 w-72">
            <a href={`${language === undefined ? "" : `/${language}`}/nieuws/${item.slug}`} class="group flex flex-col h-full border border-neutral-200 rounded-xl hover:-translate-y-1 hover:shadow transition overflow-hidden">
              <Image src={`${item.image.url}`} width={300} height={200} alt={item.image.alt} class="aspect-video w-full object-cover" />
              <div class="p-6">
                <h3 class="font-bold text-lg group-hover:text-[var(--brand)] transition">{item.title}</h3>
                <span class="text-xs text-neutral-500">{format_date(item.date)}</span>
                <p class="text-sm text-neutral-600 mt-2">{get_excerpt(item.content)}</p>
                <span class="text-sm font-semibold text-[var(--brand)] mt-2">
                  {language === "nl"
                    ? "Lees verder"
                    : "Learn more"}
                </span>
              </div>
            </a>
          </li>
        ))}
        <li class="shrink-0 w-72">
          <a href={`${language === "nl" ? "" : `/${language}`}/nieuws/`} class="group flex flex-col h-full border border-neutral-200 rounded-xl p-6 hover:-translate-y-1 hover:shadow transition">
            <div class="m-auto text-(--brand) flex flex-row gap-2 group">
              <h3 class="font-semibold text-xl">
                {language === "nl"
                  ? "Meer nieuws"
                  : "More news"}
              </h3>
              <i class="fas fa-arrow-right my-auto group-hover:translate-x-1 transition"></i>
            </div>
          </a>
        </li>
      </ul>
    </div>
  ) : (
    <p class="text-neutral-600">
      {language === "nl"
        ? "Er is momenteel geen nieuws."
        : "There is currently no news."}
    </p>
  )}
</section>

<script>
  const track = document.getElementById('news-carousel-track');
  const left_btn = document.getElementById('news-carousel-left');
  const right_btn = document.getElementById('news-carousel-right');

  if (track) {
    const scroll_amount = () => track.clientWidth * 0.6;
    left_btn?.addEventListener('click', () => track.scrollBy({ left: -scroll_amount(), behavior: 'smooth' }));
    right_btn?.addEventListener('click', () => track.scrollBy({ left: scroll_amount(), behavior: 'smooth' }));
  }
</script>
