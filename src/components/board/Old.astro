---
import { Image } from "astro:assets";
import payload from "../../payload";
const { blok, language } = Astro.props;

const old_boards = (await payload.find({
  collection: "boards",
  sort: "-boardNumber",
  draft: false,
  locale: language,
  limit: 100,
  depth: 3
})).docs.slice(1);
---

<ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
  {old_boards.map(board => (
    <li>
      <a href={`/${language === "nl" ? "" : `${language}/`}vereniging/bestuur/${board.boardNumber}`} class="group block h-56">
        <div class="relative flex h-full rounded-xl overflow-hidden border-4 group-hover:-translate-y-1 group-hover:shadow transition" style={{ "border-color": board.colour }}>
          <Image
            src={`${board.photo.url}`}
            alt={board.photo.alt || ""}
            width={500} height={400}
            class="absolute w-full h-full object-cover object-top"
          />
          <span class="relative mt-auto ml-auto m-2 px-2 py-1 rounded bg-black/25 text-white font-bold">
            {language === "nl" ? "Bestuur " : "Board "}
            {board.boardNumber} | {board.year}
          </span>
        </div>
      </a>
    </li>
  ))}
</ul>