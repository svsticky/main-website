---
import { Image } from "astro:assets";
import payload from "../../payload";
const { language } = Astro.props;

const { docs: [current_board] } = await payload.find({
  collection: "boards",
  sort: "-boardNumber",
  locale: language,
  limit: 1,
  draft: false
});
---

<a href={`/${language === "nl" ? "" : `${language}/`}vereniging/bestuur/${current_board.boardNumber}`} class="group block max-w-4xl mx-auto">
  <div class="rounded-2xl overflow-hidden border border-neutral-200 group-hover:-translate-y-1 group-hover:shadow transition">
    <Image src={`${current_board.photo.url}`} alt={current_board.photo.alt} width={1000} height={800} class="w-full aspect-video object-cover object-center" />
    <div class="w-full text-white text-center py-4" style={{ background: current_board.colour }}>
      <h3 class="text-2xl font-extrabold">
        {language === undefined ? "Bestuur " : "Board "}
        {current_board.boardNumber}
      </h3>
      {!!current_board.year && <p>{current_board.year}</p>}
      {!!current_board.zinspreuk && <p class="italic">"{current_board.zinspreuk}"</p>}
    </div>
  </div>
</a>