---
import { Image } from "astro:assets";
import RichText from '../basics/RichText.astro';
import Separator from '../basics/Separator.astro';
import Block from "../Block.astro";
import payload from "../../payload";
const { blok, language } = Astro.props;

const { docs: vacancies } = await payload.find({
  collection: "vacancies",
  draft: false,
  locale: language,
  where: { "partner.id": { equals: blok.id } }
});
---

<main class="w-[92%] sm:w-3/4 mx-auto py-8 min-h-[calc(100vh-160px)] flex flex-col gap-8">
  <div>
    <a href={`/${language === "nl" ? "" : `${language}/`}carriere/partners`} class="text-[var(--brand-dark)] flex flex-row gap-2 group w-max mb-4">
      <i class="my-auto fas fa-arrow-left group-hover:-translate-x-1 transition-transform"></i>
      <span class="group-hover:underline">
        {language === "nl" ? "Terug naar het partneroverzicht" : "Back to the partner overview"}
      </span>
    </a>

    <div class="rounded-xl border border-neutral-200 overflow-hidden mt-4">
      <div class="border-b border-neutral-200 w-full flex flex-col sm:flex-row items-center gap-4 p-4 text-center sm:text-left">
        {!!blok.logo.url &&
          <Image
            class="aspect-square h-24 w-24 object-contain border border-neutral-200 rounded-lg p-2"
            src={`${blok.logo.url}`}
            width={200} height={200}
            fit='contain'
            alt={blok.name}
          />}
        <h1 class="font-bold text-3xl">{blok.name}</h1>
        <ul class="flex flex-row flex-wrap justify-center gap-4 sm:ml-auto">
          {blok.buttons.map((button: any) => <li><Block block={button} language={language} /></li>)}
        </ul>
      </div>
      <RichText class="p-6" content={blok.body} />
    </div>
  </div>

  {!!vacancies.length && <>
    <Separator />
    <div>
      <h2 class="text-2xl font-bold mb-4">
        {language === "nl" ? "Vacatures bij" : "Vacancies at"} {blok.name}
      </h2>
      <ul class="grid grid-cols-2 sm:grid-cols-4 gap-6">
        {vacancies.map((vacancy: any) => (
          <li>
            <a href={(language === "nl" ? "/" : `/${language}/`) + vacancy.slug} class="group flex flex-col h-full border border-neutral-200 rounded-xl overflow-hidden hover:-translate-y-1 hover:shadow-lg hover:border-[var(--brand)] transition">
              <div class="aspect-square p-4 border-b border-neutral-200 flex items-center justify-center">
                {!!blok.logo.url &&
                  <Image
                    class="max-w-full max-h-full object-contain"
                    src={`${blok.logo.url}`}
                    width={200} height={200}
                    fit="contain"
                    alt={blok.name}
                  />}
              </div>
              <div class="p-4 flex flex-col gap-1 text-center flex-1">
                <span class="font-bold group-hover:text-[var(--brand)] transition">{vacancy.name}</span>
                <p class="text-sm text-neutral-600">{vacancy.shortText}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </>}
</main>
