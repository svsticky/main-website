---
import { Image } from "astro:assets";
import payload from "../../payload";

const { blok, language } = Astro.props;

const { docs: partners } = await payload.find({
  collection: "partners",
  draft: false,
  locale: language,
  limit: 1000
});
// const partners = await getAll('cdn/stories', {
//   version: 'published',
//   starts_with: 'carriere/partners',
//   content_type: 'partner',
// });

const main_partners = partners.filter(partner => partner.isMain);
const regular_partners = partners.filter(partner => !partner.isMain);
const displayed_partners = main_partners.concat(regular_partners);
---

<div class="overflow-x-hidden overflow-y-visible w-full py-4">
  <ul class="overflow-y-visible" id="conveyor" style={{ "animation-duration": `${displayed_partners.length * 2}s` }}>
    {[...displayed_partners, ...displayed_partners].map(partner => (
      <a href={"/" + (language === "nl" ? "" : `${language}/`) + partner.full_slug} class="hover:-translate-y-2 transition">
        <li>
          <Image
            width={200}
            height={200}
            alt={partner.name}
            src={`${partner.logo.url}`}
            fit="contain"
            class="object-contain"
          />
        </li>
      </a>
    ))}
  </ul>
</div>

<style>
#conveyor {
  display: flex;
  gap: 2rem;
  width: max-content;
  animation-name: scroll;
  animation-iteration-count: infinite;
  animation-timing-function: linear;
}

#conveyor:hover {
  animation-play-state: paused;
}

#conveyor img {
  height: 150px;
  width: 150px;
}

@keyframes scroll {
  to { transform: translateX(calc(-50% - 1rem)); }
}
</style>