---
const blok = Astro.props;
const url = blok.link.type === "external" ? blok.link.url : `/${blok.link.slug}`;
---

<a href={url}>
  <button class="flex flex-row gap-2 px-2 py-1 bg-[var(--brand)] text-white font-semibold rounded hover:bg-[var(--brand-dark)] hover:-translate-y-0.5 transition cursor-pointer">
    {blok.iconLocation === "left" ? <i class={`my-auto fas fa-${blok.icon}`}></i> : undefined}
    {blok.title}
    {blok.iconLocation === "right" ? <i class={`my-auto fas fa-${blok.icon}`}></i> : undefined}
  </button>
</a>