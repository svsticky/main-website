---
import { Image } from "astro:assets";
const { blok, language } = Astro.props;

import { MultiSelectInput } from "./MultiSelectInput";
import payload from "../../payload";

let { docs: vacancies } = await payload.find({
  draft: false,
  locale: language,
  collection: "vacancies",
  sort: "name",
  depth: 3
});
vacancies = vacancies.map(vacancy => ({
  ...vacancy,
  studies: vacancy.studies.map(study => study.id),
  types: vacancy.types.map(type => type.id)
}));

const { docs: studies } = await payload.find({
  collection: 'programmes',
  draft: false,
  locale: language,
  limit: 50
});

const options = [
  {
    label: { nl: "Bachelor opleidingen", en: "Bachelor programmes" },
    values: studies.filter((study: any) => study.type === "Bachelor").map((study: any) => ({ key: study.id, value: study.name }))
  },
  {
    label: { nl: "Master opleidingen", en: "Master programmes" },
    values: studies.filter((study: any) => study.type === "Master").map((study: any) => ({ key: study.id, value: study.name }))
  }
];

const { docs: types } = await payload.find({
  collection: "job-types",
  draft: false,
  locale: language,
  limit: 50
});
const type_options = types.map((type: any) => ({ key: type.id, value: type.name }));
---

<div>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <span class="text-sm text-neutral-600">
        {language === "nl" ? "Filter op opleiding:" : "Filter on programme:"}
      </span>
      <MultiSelectInput
        client:load
        placeholder={language === "nl" ? "Selecteer een opleiding om te filteren" : "Select a programme to filter"}
        options={options}
        atom_name="programme_filter"
        language={language}
      />
    </div>
    <div>
      <span class="text-sm text-neutral-600">
        {language === "nl" ? "Filter op type:" : "Filter on vacancy type:"}
      </span>
      <MultiSelectInput
        client:load
        placeholder={language === "nl" ? "Selecteer een type om te filteren" : "Select a type to filter"}
        options={type_options}
        atom_name="type_filter"
        language={language}
      />
    </div>
  </div>

  <div class="mt-8">
    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-6" id="vacatures">
      {vacancies.map((vacancy: any) =>
        <a class="group" href={`/${language === "nl" ? "" : `${language}/`}${vacancy.slug}`} data-types={vacancy.types} data-studies={vacancy.studies}>
          <li class="flex flex-col h-full border border-neutral-200 rounded-xl overflow-hidden group-hover:-translate-y-1 group-hover:shadow-lg group-hover:border-[var(--brand)] transition">
            <div class="aspect-square p-6 border-b border-neutral-200 flex items-center justify-center">
              {!!vacancy.partner[0].logo.url &&
                <Image
                  class="max-w-full max-h-full object-contain"
                  src={`${vacancy.partner[0].logo.url}`}
                  alt={vacancy.partner[0].name}
                  fit='contain'
                  width={200} height={200}
                />}
            </div>
            <div class="p-4 flex flex-col gap-4 text-center flex-1">
              <span class="font-bold text-lg group-hover:text-[var(--brand)] transition">{vacancy.name}</span>
              <p class="text-sm text-neutral-600">{vacancy.shortText}</p>
            </div>
          </li>
        </a>
      )}
    </ul>
  </div>
</div>

<script>
  import { programme_filter, type_filter } from "./store";

  const vacancy_container = document.getElementById("vacatures")!;
  const vacancies = Array.from(vacancy_container.children) as HTMLElement[];

  function passes_filter(vacancy: HTMLElement) {
    const types = (vacancy.dataset["types"] ?? "").split(",").map(Number);
    const programmes = (vacancy.dataset["studies"] ?? "").split(",").map(Number);
    const active_programmes = programme_filter.get();
    const active_types = type_filter.get();
    return (!active_types.length || types.some(type => active_types.includes(type)))
      && (!active_programmes.length || programmes.some(programme => active_programmes.includes(programme)));
  }

  function apply_filters() {
    for (const vacancy of vacancies) {
      vacancy.classList.add(passes_filter(vacancy) ? "block" : "hidden");
      vacancy.classList.remove(passes_filter(vacancy) ? "hidden" : "block");
    }
  }

  programme_filter.listen(() => { apply_filters(); });
  type_filter.listen(() => { apply_filters(); });
</script>