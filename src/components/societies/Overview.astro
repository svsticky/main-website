---
import { Image } from "astro:assets";
import payload from "../../payload";

const { blok, language } = Astro.props;

const { docs: societies } = await payload.find({
  draft: false,
  locale: language,
  collection: "societies",
  sort: "name"
});
---

<ul class="flex flex-col gap-6">
  {societies.map(society => (
    <li>
      <a href={`/${language === "nl" ? "" : `${language}/`}${society.slug}`} class="group block">
        <div
          class="flex flex-col sm:flex-row items-center gap-4 rounded-xl overflow-hidden text-white p-4 group-hover:-translate-y-1 group-hover:shadow transition"
          style={{ background: society.colour }}
        >
          {!!society.logo.url &&
            <Image
              class="w-28 sm:w-1/5 shrink-0 aspect-square object-contain object-center"
              src={`${society.logo.url}`}
              width={200}
              height={200}
              fit="contain"
              position="center"
              alt={society.name}
            />}
          <div class="w-full sm:w-3/4 text-center sm:text-left">
            <h3 class="font-bold text-xl">{society.name}</h3>
            <p class="mt-1">{society.shortText}</p>
          </div>
        </div>
      </a>
    </li>
  ))}
</ul>
