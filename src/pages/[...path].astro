import type { GetStaticPaths } from "astro";
import payload from "../payload";
import Layout from '../layouts/Layout.astro';
import Collection from "../components/Collection.astro";

export const getStaticPaths = (async () => {
  const languages = [undefined, "en"];

  const pages_per_language = await Promise.all(languages.map(async locale => {
    const collections = ["pages", "vacancies", "boards", "partners", "news-items", "societies", "committees"]
    const stories = (await Promise.all(collections.map(async collection => {
      const docs = await payload.find({
        collection,
        locale,
        draft: false,
        limit: 1000
      });
      return docs.docs.map(doc => ({ ...doc, collection }) as { slug: string, id: number, collection: string });
    }))).flat();

    return stories.map(story =>
      story.slug === "home"
        ? ({
            params: { path: `/${locale ?? ""}` },
            props: { id: story.id, collection: story.collection, slug: "", language: locale ?? "nl" }
          })
        : ({
            params: { path: `${locale ? `/${locale}` : ""}/${story.slug}` },
            props: { id: story.id, collection: story.collection, slug: story.slug, language: locale ?? "nl" }
          })
    );
  }));
  
  return pages_per_language.flat();
}) satisfies GetStaticPaths;

const { id, slug, collection, language } = Astro.props;

const story = await payload.findByID({ collection, id, depth: 4, locale: language });

function preloaded_url(url: string) {
  const storyblok_url_parts = url.split("/");
  return `https://${Astro.site!.host}/assets/preloaded/${storyblok_url_parts[storyblok_url_parts.length - 1]}`;
}

